# Local runtime state and deployment snapshots
/runtime/

# Local secrets. Keep checked-in examples available.
**/.env
**/.env.*
!**/.env.example

# Application-generated state
/apps/r1-supermarket/.venv/
/apps/r1-supermarket/data/
/apps/r1-supermarket/logs/
/apps/r1-supermarket/backups/
/apps/r1-supermarket/frontend/node_modules/
/apps/r1-supermarket/frontend/dist/
/apps/r1-collection-console/frontend/node_modules/
/apps/r1-collection-console/frontend/dist/

# Robot diagnostics and generated datasets
/robot/xr-teleoperate/teleop/logs/
/robot/xr-teleoperate/teleop/data/

# Local model training runs and checkpoints
/outputs/

