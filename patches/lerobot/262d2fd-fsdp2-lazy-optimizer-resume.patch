@@ -163,11 +163,48 @@ def load_sharded_optimizer(
     """
     from accelerate.utils import load_fsdp_optimizer
     from accelerate.utils.constants import OPTIMIZER_NAME
+    from torch.distributed.fsdp.fully_sharded_data_parallel import StateDictType
 
     # Exact shard directory for the same reason as load_sharded_model: accelerate's substring
     # check ("optimizer" in the path) would misread e.g. --job_name=optimizer_sweep run paths.
+    plugin = _fsdp_plugin(accelerator)
+    shard_dir = input_dir / f"{OPTIMIZER_NAME}_0"
+
+    if plugin.fsdp_version == 2 and plugin.state_dict_type != StateDictType.FULL_STATE_DICT:
+        # Adam creates state lazily, only after a parameter receives its first gradient. PI0.5
+        # contains output heads that are registered as trainable but are not used by the flow
+        # matching action loss, so a valid checkpoint has no state entries for those parameters.
+        # Accelerate's strict DCP planner asks for entries for every optimizer parameter and fails
+        # before set_optimizer_state_dict() can preserve the fresh empty state. Use DCP's supported
+        # partial-load mode: existing checkpoint entries remain strict, while genuinely absent lazy
+        # optimizer entries keep their freshly initialized value.
+        import torch.distributed.checkpoint as dist_cp
+        from torch.distributed.checkpoint import DefaultLoadPlanner
+        from torch.distributed.checkpoint.state_dict import (
+            StateDictOptions,
+            get_optimizer_state_dict,
+            set_optimizer_state_dict,
+        )
+
+        options = StateDictOptions(
+            full_state_dict=False,
+            cpu_offload=getattr(plugin.state_dict_config, "offload_to_cpu", False),
+            broadcast_from_rank0=getattr(plugin.state_dict_config, "rank0_only", False),
+        )
+        optim_state = get_optimizer_state_dict(model, optimizer, options=options)
+        wrapped_state = {"optimizer": optim_state}
+        accelerator.wait_for_everyone()
+        dist_cp.load(
+            state_dict=wrapped_state,
+            storage_reader=dist_cp.FileSystemReader(shard_dir),
+            planner=DefaultLoadPlanner(allow_partial_load=True),
+        )
+        set_optimizer_state_dict(model, optimizer, wrapped_state["optimizer"], options=options)
+        accelerator.wait_for_everyone()
+        return
+
     load_fsdp_optimizer(
-        _fsdp_plugin(accelerator), accelerator, optimizer, model, str(input_dir / f"{OPTIMIZER_NAME}_0")
+        plugin, accelerator, optimizer, model, str(shard_dir)
     )
 
 
