     last_checkpoint_dir.symlink_to(relative_target)


+def _checkpoint_is_complete(checkpoint_dir: Path) -> bool:
+    """Return true only when model and optimizer state needed for resume are present."""
+    pretrained_dir = checkpoint_dir / PRETRAINED_MODEL_DIR
+    training_state_dir = checkpoint_dir / TRAINING_STATE_DIR
+    if not (pretrained_dir / "train_config.json").is_file():
+        return False
+    if not (training_state_dir / TRAINING_STEP).is_file():
+        return False
+    model_ok = (pretrained_dir / "model.safetensors").is_file() or any(
+        child.is_dir()
+        and child.name.startswith("pytorch_model_fsdp_")
+        and any(item.is_file() for item in child.rglob("*"))
+        for child in pretrained_dir.iterdir()
+    )
+    optimizer_ok = (training_state_dir / "optimizer_state.safetensors").is_file() or any(
+        child.is_dir()
+        and child.name.startswith("optimizer_")
+        and any(item.is_file() for item in child.rglob("*"))
+        for child in training_state_dir.iterdir()
+    )
+    return model_ok and optimizer_ok
+
+
+def prune_old_checkpoints(checkpoint_dir: Path, keep_last: int, keep_steps: list[int]) -> None:
+    """Delete old completed checkpoints after a newer save has been published via `last`.
+
+    This function is rank-0-only and must be called after ``update_last_checkpoint``. Incomplete
+    directories are never deleted, and the current `last` target is always protected.
+    """
+    if keep_last <= 0:
+        return
+    checkpoints_dir = checkpoint_dir.parent
+    completed = sorted(
+        (
+            (int(path.name), path)
+            for path in checkpoints_dir.iterdir()
+            if path.is_dir() and path.name.isdigit() and _checkpoint_is_complete(path)
+        ),
+        key=lambda item: item[0],
+    )
+    protected = {path for _, path in completed[-keep_last:]}
+    protected.update(path for step, path in completed if step in set(keep_steps))
+    last_link = checkpoints_dir / LAST_CHECKPOINT_LINK
+    if last_link.is_symlink():
+        protected.add(last_link.resolve())
+    for step, path in completed:
+        if path in protected:
+            continue
+        shutil.rmtree(path)
+        logging.info("Pruned completed checkpoint step %d at %s", step, path)
+
+
