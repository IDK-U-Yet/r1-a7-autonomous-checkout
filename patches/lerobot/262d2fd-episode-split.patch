+def _resolve_episode_split_episodes(
+    cfg: TrainPipelineConfig, ds_meta: LeRobotDatasetMetadata
+) -> tuple[list[int], list[int] | None]:
+    """Resolve train (and optional held-out eval) episodes from an episode split manifest.
+
+    The manifest (produced by the R1-A7 make_r1a7_episode_split.py tooling) assigns every
+    output episode to exactly one split, grouped by ORIGINAL teaching episode so the
+    scan/place segments of one trajectory never separate. When eval_split > 0, the eval
+    episodes come from `cfg.dataset.episode_eval_split_name` and must be disjoint from the
+    training split.
+    """
+    payload = json.loads(Path(cfg.dataset.episode_split_path).read_text(encoding="utf-8"))
+    total_episodes = int(payload.get("dataset", {}).get("total_output_episodes", -1))
+    if total_episodes != ds_meta.total_episodes:
+        raise ValueError(
+            f"episode split manifest total_output_episodes={total_episodes} does not match "
+            f"dataset total_episodes={ds_meta.total_episodes}"
+        )
+    splits = payload.get("splits", {})
+
+    def episodes_of(name: str) -> list[int]:
+        if name not in splits:
+            raise ValueError(
+                f"episode split manifest {cfg.dataset.episode_split_path!r} has no split "
+                f"{name!r}; available splits: {sorted(splits)}"
+            )
+        episodes = sorted(int(index) for index in splits[name]["output_episode_indices"])
+        if not episodes:
+            raise ValueError(f"episode split {name!r} is empty")
+        if episodes[0] < 0 or episodes[-1] >= ds_meta.total_episodes:
+            raise ValueError(f"episode split {name!r} contains out-of-range episode indices")
+        return episodes
+
+    train_episodes = episodes_of(cfg.dataset.episode_split_name)
+    eval_episodes = None
+    if cfg.dataset.eval_split > 0.0:
+        eval_episodes = episodes_of(cfg.dataset.episode_eval_split_name)
+        overlap = sorted(set(train_episodes) & set(eval_episodes))
+        if overlap:
+            raise ValueError(
+                f"episode split leakage: {len(overlap)} episodes appear in both the "
+                f"{cfg.dataset.episode_split_name!r} and {cfg.dataset.episode_eval_split_name!r} "
+                f"splits (first few: {overlap[:8]})"
+            )
+    logging.info(
+        "Episode split manifest %s: %d train episodes (%s split), %s",
+        cfg.dataset.episode_split_path,
+        len(train_episodes),
+        cfg.dataset.episode_split_name,
+        f"{len(eval_episodes)} eval episodes ({cfg.dataset.episode_eval_split_name} split)"
+        if eval_episodes is not None
+        else "eval disabled (eval_split=0)",
+    )
+    return train_episodes, eval_episodes
+
+
